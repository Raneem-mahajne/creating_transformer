\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Figure 9.} Output probability landscape (per-unit view). Each subplot shows the softmax probability \(P(\text  {next} = \text  {token})\) over the 2D plane for one output token (digits 0--10 and the \texttt {+} operator).}}{14}{figure.caption.9}\protected@file@percent }
