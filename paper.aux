\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Figure 2.} Sample training sequences as heatmaps. Green: constrained position (immediately after \texttt {+}) with the correct next token (the most recent even number). Gray: unconstrained position (any token is valid).}}{6}{figure.caption.2}\protected@file@percent }
