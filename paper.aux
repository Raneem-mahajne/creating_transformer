\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Figure 7.} Query--key geometry in Q/K space. \textbf  {Top:} joint query--key space (blue: queries; red: keys; labels show token and position). \textbf  {Bottom:} Focus on the query \(+_5\) (blue); background color indicates the dot product of the \(+_5\) query with every point in space. Keys with position \(\geq 5\) are grayed due to the causal mask.}}{12}{figure.caption.7}\protected@file@percent }
