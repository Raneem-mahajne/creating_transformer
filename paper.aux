\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Figure 4.} Model-generated sequences at initialization (top) vs.~after training (bottom). Green = correct at constrained positions (after \texttt {+}), red = wrong at constrained positions, gray = unconstrained. Top: at step 0, constrained positions are mostly red (random predictions). Bottom: after training, constrained positions are mostly green (correct ``last even'' outputs).}}{8}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Figure 5.} Learned embeddings. (a) Token embeddings \(\mathbf  {x}_i\) shown as heatmap. (b) Position embeddings \(\mathbf  {p}_i\) shown as heatmap. (c) Combined token+position embeddings shown as scatterplot. (d) Positions \(\mathbf  {p}_i\) shown as scatterplot. (e) Token+position embeddings \(\mathbf  {e}_i\) shown as scatterplot. Positions are indicated as subscripts next to each token e.g.~\(+_5\) is the \texttt {+} token at position 5.}}{9}{figure.caption.5}\protected@file@percent }
